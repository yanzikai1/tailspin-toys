---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import GameFilters from '../components/GameFilters.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categoryMap = new Map<number, string>();
const publisherMap = new Map<number, string>();

for (const game of games) {
  if (game.category) {
    categoryMap.set(game.category.id, game.category.name);
  }
  if (game.publisher) {
    publisherMap.set(game.publisher.id, game.publisher.name);
  }
}

const categoryOptions = Array.from(categoryMap, ([id, name]) => ({ id, name }))
  .sort((first, second) => first.name.localeCompare(second.name));
const publisherOptions = Array.from(publisherMap, ([id, name]) => ({ id, name }))
  .sort((first, second) => first.name.localeCompare(second.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <GameFilters
            categories={categoryOptions}
            publishers={publisherOptions}
            totalGames={games.length}
          />
          <div
            id="games-grid"
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
            data-testid="games-grid"
          >
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div id="no-filter-results" hidden>
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>
