---
import type { Category, Publisher } from '../types/game';

interface Props {
    categories: Category[];
    publishers: Publisher[];
    totalGames: number;
}

const { categories, publishers, totalGames } = Astro.props;
---

<section
    class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5 shadow-lg backdrop-blur-sm"
    aria-labelledby="game-filters-heading"
>
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
        <div>
            <h2 id="game-filters-heading" class="text-xl font-semibold text-slate-100">
                Filter games
            </h2>
            <p class="mt-1 text-sm text-slate-300">
                Choose any categories and one publisher.
            </p>
        </div>
        <button
            type="button"
            data-testid="clear-filters"
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:border-blue-400 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 disabled:cursor-not-allowed disabled:opacity-50"
            disabled
        >
            Clear filters
        </button>
    </div>

    <form data-testid="game-filters" class="grid gap-5 lg:grid-cols-[2fr_1fr]">
        <fieldset>
            <legend class="mb-3 font-medium text-slate-100">Categories</legend>
            <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                    <label
                        class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 bg-slate-900/50 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-400 has-checked:border-blue-500 has-checked:bg-blue-500/10"
                    >
                        <input
                            type="checkbox"
                            name="category"
                            value={category.id}
                            data-testid={`category-filter-${category.id}`}
                            aria-controls="games-grid"
                            class="size-4 rounded border-slate-500 bg-slate-800 text-blue-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-800"
                        />
                        <span>{category.name}</span>
                    </label>
                ))}
            </div>
        </fieldset>

        <div>
            <label for="publisher-filter" class="mb-3 block font-medium text-slate-100">
                Publisher
            </label>
            <select
                id="publisher-filter"
                name="publisher"
                data-testid="publisher-filter"
                aria-controls="games-grid"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
            >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                ))}
            </select>
        </div>
    </form>

    <p
        class="mt-5 text-sm text-slate-300"
        data-testid="filter-results-status"
        role="status"
        aria-live="polite"
        aria-atomic="true"
    >
        {totalGames} {totalGames === 1 ? 'game' : 'games'} shown
    </p>
</section>

<script>
    const filterForm = document.querySelector('[data-testid="game-filters"]');
    const publisherFilter = document.querySelector('[data-testid="publisher-filter"]');
    const clearFilters = document.querySelector('[data-testid="clear-filters"]');
    const resultStatus = document.querySelector('[data-testid="filter-results-status"]');
    const gamesGrid = document.getElementById('games-grid');
    const noResults = document.getElementById('no-filter-results');

    if (
        !(filterForm instanceof HTMLFormElement)
        || !(publisherFilter instanceof HTMLSelectElement)
        || !(clearFilters instanceof HTMLButtonElement)
        || !(resultStatus instanceof HTMLParagraphElement)
        || !(gamesGrid instanceof HTMLElement)
        || !(noResults instanceof HTMLElement)
    ) {
        throw new Error('Game filter controls could not be initialized.');
    }

    const categoryFilters = Array.from(
        filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]'),
    );
    const gameCards = Array.from(
        gamesGrid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'),
    );

    const updateResults = (): void => {
        const selectedCategories = new Set(
            categoryFilters
                .filter((filter) => filter.checked)
                .map((filter) => filter.value),
        );
        const selectedPublisher = publisherFilter.value;
        let visibleGames = 0;

        for (const card of gameCards) {
            const matchesCategory = selectedCategories.size === 0
                || selectedCategories.has(card.dataset.categoryId ?? '');
            const matchesPublisher = selectedPublisher === ''
                || card.dataset.publisherId === selectedPublisher;
            const isVisible = matchesCategory && matchesPublisher;

            card.hidden = !isVisible;
            if (isVisible) {
                visibleGames += 1;
            }
        }

        gamesGrid.hidden = visibleGames === 0;
        noResults.hidden = visibleGames !== 0;
        clearFilters.disabled = selectedCategories.size === 0 && selectedPublisher === '';
        resultStatus.textContent = `${visibleGames} ${visibleGames === 1 ? 'game' : 'games'} shown`;
    };

    filterForm.addEventListener('change', updateResults);
    clearFilters.addEventListener('click', () => {
        filterForm.reset();
        updateResults();
    });
</script>
